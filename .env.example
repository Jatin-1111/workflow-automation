# MongoDB (docker-compose reads these too)
MONGO_PORT=27017
MONGO_ROOT_USER=orbit
MONGO_ROOT_PASSWORD=orbit
MONGO_DB=business_orbit
MONGODB_URI=mongodb://orbit:orbit@localhost:27017/business_orbit?authSource=admin

# Password applied to every seeded demo user
SEED_PASSWORD=orbit1234

# Signing key for session cookies (openssl rand -base64 32)
SESSION_SECRET=replace-with-a-32-byte-random-value

# Shared secret for the reminder scheduler endpoint (/api/cron/reminders)
CRON_SECRET=replace-with-a-shared-secret

# File storage. Leave unset to keep files on local disk, which is the default
# for development. Set all three (or CLOUDINARY_URL) to store in Cloudinary,
# which is required on a serverless host, where the filesystem does not survive
# the request.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# Namespaces this deployment's assets. Set it per environment: a reseed deletes
# everything under this folder.
# CLOUDINARY_FOLDER=business-orbit
